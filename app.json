{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "com.pepane13.pelletstove",
  "version": "0.3.2",
  "compatibility": ">=12.0.0",
  "sdk": 3,
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Pellet Stove Manager",
    "fr": "Gestion Poêle à Granulés"
  },
  "description": {
    "en": "Monitor and manage your Duepi EVO pellet stove: status, alarms, burn hours, maintenance and room temperatures.",
    "fr": "Surveillez et gérez votre poêle à granulés Duepi EVO : état, alarmes, heures de combustion, entretien et températures de la maison."
  },
  "category": [
    "climate"
  ],
  "tags": {
    "en": [
      "pellet stove",
      "Duepi",
      "myDPRemote",
      "Interstoves",
      "heating"
    ],
    "fr": [
      "poêle à granulés",
      "Duepi",
      "myDPRemote",
      "Interstoves",
      "chauffage"
    ]
  },
  "permissions": [
    "homey:manager:api",
    "homey:manager:geolocation"
  ],
  "brandColor": "#E8681A",
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Pepane13"
  },
  "source": "https://github.com/Pepane13/homey-pellet-stove-manager",
  "bugs": {
    "url": "https://github.com/Pepane13/homey-pellet-stove-manager/issues"
  },
  "api": {
    "getSources": {
      "method": "GET",
      "path": "/sources"
    },
    "getStatus": {
      "method": "GET",
      "path": "/status"
    },
    "resetLearning": {
      "method": "POST",
      "path": "/learning/reset"
    }
  },
  "flow": {
    "triggers": [
      {
        "id": "stove_alarm_raised",
        "title": {
          "en": "A stove alarm was raised",
          "fr": "Une alarme du poêle s'est déclenchée"
        },
        "tokens": [
          {
            "name": "code",
            "type": "number",
            "title": {
              "en": "Code",
              "fr": "Code"
            },
            "example": 5
          },
          {
            "name": "message",
            "type": "string",
            "title": {
              "en": "Message",
              "fr": "Message"
            },
            "example": {
              "en": "Out of pellets",
              "fr": "Manque de pellets"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "stove_alarm_cleared",
        "title": {
          "en": "The stove alarm was cleared",
          "fr": "L'alarme du poêle a disparu"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "stove_status_changed",
        "title": {
          "en": "The stove status changed",
          "fr": "L'état du poêle a changé"
        },
        "tokens": [
          {
            "name": "status",
            "type": "string",
            "title": {
              "en": "Status",
              "fr": "État"
            },
            "example": {
              "en": "Heating",
              "fr": "En chauffe"
            }
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "stove_connection_lost",
        "title": {
          "en": "Connection to the stove was lost",
          "fr": "La liaison avec le poêle est perdue"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "sensor_unavailable",
        "title": {
          "en": "A temperature sensor became unavailable",
          "fr": "Une sonde de température est indisponible"
        },
        "tokens": [
          {
            "name": "role",
            "type": "string",
            "title": {
              "en": "Role",
              "fr": "Rôle"
            },
            "example": {
              "en": "Outdoor",
              "fr": "Extérieur"
            }
          },
          {
            "name": "sensor",
            "type": "string",
            "title": {
              "en": "Sensor",
              "fr": "Sonde"
            },
            "example": "Météo extérieur Piscine"
          },
          {
            "name": "reason",
            "type": "string",
            "title": {
              "en": "Reason",
              "fr": "Raison"
            },
            "example": {
              "en": "No recent value",
              "fr": "Pas de valeur récente"
            }
          },
          {
            "name": "replacement",
            "type": "string",
            "title": {
              "en": "Replacement",
              "fr": "Remplaçante"
            },
            "example": "Météo couloir extérieur"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "sensor_restored",
        "title": {
          "en": "A temperature sensor is available again",
          "fr": "Une sonde de température est de nouveau disponible"
        },
        "tokens": [
          {
            "name": "role",
            "type": "string",
            "title": {
              "en": "Role",
              "fr": "Rôle"
            },
            "example": {
              "en": "Outdoor",
              "fr": "Extérieur"
            }
          },
          {
            "name": "sensor",
            "type": "string",
            "title": {
              "en": "Sensor",
              "fr": "Sonde"
            },
            "example": "Météo extérieur Piscine"
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "heat_start_due",
        "title": {
          "en": "It is time to start heating for a target",
          "fr": "Il est temps d'allumer pour un objectif"
        },
        "hint": {
          "en": "Raised at the start time computed for a target set with « Reach … °C at … ». If the room is already warm enough, raised 5 minutes before the target time with « Heating needed » = no.",
          "fr": "Déclenché à l'heure d'allumage calculée pour un objectif fixé avec « Atteindre … °C à … ». Si la pièce est déjà assez chaude, déclenché 5 minutes avant l'heure visée avec « Chauffe nécessaire » = non."
        },
        "tokens": [
          {
            "name": "target",
            "type": "number",
            "title": {
              "en": "Target temperature",
              "fr": "Température visée"
            },
            "example": 21
          },
          {
            "name": "time",
            "type": "string",
            "title": {
              "en": "Target time",
              "fr": "Heure visée"
            },
            "example": "06:20"
          },
          {
            "name": "lead",
            "type": "number",
            "title": {
              "en": "Minutes before the target",
              "fr": "Minutes avant l'objectif"
            },
            "example": 150
          },
          {
            "name": "needed",
            "type": "boolean",
            "title": {
              "en": "Heating needed",
              "fr": "Chauffe nécessaire"
            },
            "example": true
          },
          {
            "name": "reachable",
            "type": "boolean",
            "title": {
              "en": "Target reachable in time",
              "fr": "Objectif atteignable à temps"
            },
            "example": true
          }
        ],
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "stove_is_heating",
        "title": {
          "en": "The stove !{{is|is not}} heating",
          "fr": "Le poêle !{{est|n'est pas}} en chauffe"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "stove_has_alarm",
        "title": {
          "en": "The stove !{{has|has no}} active alarm",
          "fr": "Le poêle !{{a|n'a pas}} d'alarme active"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      },
      {
        "id": "heat_target_pending",
        "title": {
          "en": "A temperature target !{{is|is not}} pending",
          "fr": "Un objectif de température !{{est|n'est pas}} en attente"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_heat_target",
        "title": {
          "en": "Reach a temperature at a time",
          "fr": "Atteindre une température à une heure"
        },
        "titleFormatted": {
          "en": "Reach [[temperature]] °C at [[time]]",
          "fr": "Atteindre [[temperature]] °C à [[time]]"
        },
        "hint": {
          "en": "The app computes the start time from what it has learnt and raises « It is time to start heating for a target ». It does not control the stove or the thermostat itself.",
          "fr": "L'app calcule l'heure d'allumage avec ce qu'elle a appris et déclenche « Il est temps d'allumer pour un objectif ». Elle ne commande ni le poêle ni le thermostat elle-même."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          },
          {
            "type": "number",
            "name": "temperature",
            "min": 5,
            "max": 30,
            "step": 0.5,
            "placeholder": {
              "en": "21",
              "fr": "21"
            }
          },
          {
            "type": "time",
            "name": "time"
          }
        ]
      },
      {
        "id": "cancel_heat_targets",
        "title": {
          "en": "Cancel the temperature targets",
          "fr": "Annuler les objectifs de température"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stove"
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "Pellet stove (Duepi EVO)",
        "fr": "Poêle à granulés (Duepi EVO)"
      },
      "class": "heater",
      "capabilities": [
        "stove_status",
        "alarm_generic",
        "stove_error",
        "stove_power_level",
        "measure_temperature.flue_gas",
        "measure_temperature.board",
        "stove_auger_speed",
        "stove_exhaust_speed",
        "stove_hours_total",
        "stove_hours_service",
        "measure_temperature.comfort",
        "measure_temperature.regulation",
        "stove_comfort_gap",
        "measure_temperature.outdoor",
        "measure_temperature.forecast_min",
        "stove_outdoor_source",
        "stove_heatup_minutes",
        "stove_start_time",
        "stove_heat_loss",
        "stove_heat_loss_median"
      ],
      "capabilitiesOptions": {
        "measure_temperature.flue_gas": {
          "title": {
            "en": "Flue gas temperature",
            "fr": "Température des fumées"
          }
        },
        "measure_temperature.board": {
          "title": {
            "en": "Board temperature",
            "fr": "Température de la carte"
          }
        },
        "alarm_generic": {
          "title": {
            "en": "Stove alarm",
            "fr": "Alarme du poêle"
          }
        },
        "measure_temperature.comfort": {
          "title": {
            "en": "Comfort temperature",
            "fr": "Température de confort"
          }
        },
        "measure_temperature.regulation": {
          "title": {
            "en": "Thermostat temperature",
            "fr": "Température du thermostat"
          }
        },
        "measure_temperature.outdoor": {
          "title": {
            "en": "Outdoor temperature",
            "fr": "Température extérieure"
          }
        },
        "measure_temperature.forecast_min": {
          "title": {
            "en": "Forecast minimum (6 h)",
            "fr": "Minimum prévu (6 h)"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "cloud",
        "lan"
      ],
      "images": {
        "small": "/drivers/stove/assets/images/small.png",
        "large": "/drivers/stove/assets/images/large.png",
        "xlarge": "/drivers/stove/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "configure"
        }
      ],
      "settings": [
        {
          "type": "group",
          "label": {
            "en": "Connection",
            "fr": "Connexion"
          },
          "children": [
            {
              "id": "mode",
              "type": "dropdown",
              "value": "cloud",
              "label": {
                "en": "Connection mode",
                "fr": "Mode de connexion"
              },
              "values": [
                {
                  "id": "cloud",
                  "label": {
                    "en": "Duepi cloud relay",
                    "fr": "Serveur Duepi"
                  }
                },
                {
                  "id": "local",
                  "label": {
                    "en": "Local serial bridge (ESP-Link)",
                    "fr": "Passerelle locale (ESP-Link)"
                  }
                },
                {
                  "id": "simulator",
                  "label": {
                    "en": "Simulator (no stove)",
                    "fr": "Simulateur (sans poêle)"
                  }
                }
              ]
            },
            {
              "id": "host",
              "type": "text",
              "value": "1.duepiwebserver1.com",
              "label": {
                "en": "Server or bridge address",
                "fr": "Adresse du serveur ou de la passerelle"
              }
            },
            {
              "id": "port",
              "type": "number",
              "value": 3000,
              "min": 1,
              "max": 65535,
              "label": {
                "en": "Port",
                "fr": "Port"
              }
            },
            {
              "id": "poll_interval",
              "type": "number",
              "value": 60,
              "min": 30,
              "max": 600,
              "units": {
                "en": "s",
                "fr": "s"
              },
              "label": {
                "en": "Polling interval",
                "fr": "Intervalle de relève"
              },
              "hint": {
                "en": "One reading every 60 s is enough and keeps the vendor relay unloaded.",
                "fr": "Une relève par minute suffit et ménage le serveur du fabricant."
              }
            }
          ]
        }
      ],
      "id": "stove"
    }
  ],
  "capabilities": {
    "stove_auger_speed": {
      "type": "number",
      "title": {
        "en": "Auger speed",
        "fr": "Vitesse vis sans fin"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/auger.svg",
      "insights": true,
      "decimals": 0
    },
    "stove_comfort_gap": {
      "type": "number",
      "title": {
        "en": "Comfort − thermostat gap",
        "fr": "Écart confort − thermostat"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/gap.svg",
      "insights": true,
      "units": {
        "en": "°C",
        "fr": "°C"
      },
      "decimals": 1
    },
    "stove_error": {
      "type": "string",
      "title": {
        "en": "Stove error",
        "fr": "Erreur du poêle"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/alert.svg",
      "insights": false
    },
    "stove_exhaust_speed": {
      "type": "number",
      "title": {
