      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/clock.svg",
      "insights": true,
      "units": {
        "en": "min",
        "fr": "min"
      },
      "decimals": 0
    },
    "stove_hours_service": {
      "type": "number",
      "title": {
        "en": "Hours since service",
        "fr": "Heures depuis l'entretien"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "icon": "/assets/icons/wrench.svg",
      "insights": true,
      "units": {
        "en": "h",
