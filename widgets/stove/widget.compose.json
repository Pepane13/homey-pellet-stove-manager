{
  "name": {
    "en": "Pellet stove",
    "fr": "Poêle à granulés"
  },
  "height": 480,
  "settings": [
    {
      "id": "show_month",
      "type": "checkbox",
      "title": {
        "en": "Show the month consumption",
        "fr": "Afficher la consommation du mois"
      },
      "value": true
    },
    {
      "id": "show_controls",
      "type": "checkbox",
      "title": {
        "en": "Show the target temperature controls",
        "fr": "Afficher le réglage de la température cible"
      },
      "value": true
    },
    {
      "id": "show_refill",
      "type": "checkbox",
      "title": {
        "en": "Show the « Tank refilled » button",
        "fr": "Afficher le bouton « Réservoir rechargé »"
      },
      "value": true
    }
  ],
  "api": {
    "getData": {
      "method": "GET",
      "path": "/"
    },
    "setTarget": {
      "method": "POST",
      "path": "/target"
    },
    "schedule": {
      "method": "POST",
      "path": "/schedule"
    },
    "program": {
      "method": "POST",
      "path": "/program"
    },
    "refill": {
      "method": "POST",
      "path": "/refill"
    }
  }
}
