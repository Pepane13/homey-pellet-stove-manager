  "actions": [
    {
      "id": "set_heat_target",
      "title": {
        "en": "Reach a temperature at a time",
        "fr": "Atteindre une température à une heure"
      },
      "titleFormatted": {
        "en": "Reach [[temperature]] °C at [[time]]",
        "fr": "Atteindre [[temperature]] °C à [[time]]"
      },
      "hint": {
        "en": "The app computes the start time from what it has learnt and raises « It is time to start heating for a target ». It does not control the stove or the thermostat itself.",
        "fr": "L'app calcule l'heure d'allumage avec ce qu'elle a appris et déclenche « Il est temps d'allumer pour un objectif ». Elle ne commande ni le poêle ni le thermostat elle-même."
      },
      "args": [
        {
          "type": "number",
          "name": "temperature",
          "min": 5,
          "max": 30,
          "step": 0.5,
          "placeholder": {
            "en": "21",
            "fr": "21"
          }
        },
        {
          "type": "time",
          "name": "time"
        }
      ]
    },
    {
      "id": "cancel_heat_targets",
      "title": {
        "en": "Cancel the temperature targets",
        "fr": "Annuler les objectifs de température"
      }
    },
    {
      "id": "pellets_refilled",
      "title": {
        "en": "Tank refilled (full)",
        "fr": "Réservoir rechargé (plein)"
      }
    },
    {
      "id": "set_bag_price",
      "title": {
        "en": "Set the bag price",
        "fr": "Régler le prix du sac"
      },
      "titleFormatted": {
        "en": "Bag price: [[price]] €",
        "fr": "Prix du sac : [[price]] €"
      },
      "args": [
        {
          "type": "number",
          "name": "price",
          "min": 0.5,
          "max": 50,
          "step": 0.01,
          "placeholder": {
            "en": "5.49",
            "fr": "5,49"
          }
        }
      ]
    },
    {
      "id": "cleaning_done",
      "title": {
        "en": "Cleaning done",
        "fr": "Nettoyage fait"
      }
    },
    {
      "id": "maintenance_done",
      "title": {
        "en": "Professional maintenance done",
        "fr": "Entretien professionnel effectué"
      },
      "titleFormatted": {
        "en": "Professional maintenance done: [[note]]",
        "fr": "Entretien professionnel effectué : [[note]]"
      },
      "args": [
        {
          "type": "text",
          "name": "note",
          "required": false,
          "placeholder": {
            "en": "Annual service + sweeping",
            "fr": "Entretien annuel + ramonage"
