  "actions": [
    {
      "id": "set_heat_target",
      "title": {
        "en": "Reach a temperature at a time",
        "fr": "Atteindre une température à une heure"
      },
      "titleFormatted": {
        "en": "Reach [[temperature]] °C at [[time]]",
        "fr": "Atteindre [[temperature]] °C à [[time]]"
      },
      "hint": {
        "en": "The app computes the start time from what it has learnt and raises « It is time to start heating for a target ». It does not control the stove or the thermostat itself.",
        "fr": "L'app calcule l'heure d'allumage avec ce qu'elle a appris et déclenche « Il est temps d'allumer pour un objectif ». Elle ne commande ni le poêle ni le thermostat elle-même."
      },
      "args": [
        {
          "type": "number",
          "name": "temperature",
          "min": 5,
          "max": 30,
          "step": 0.5,
          "placeholder": {
            "en": "21",
            "fr": "21"
          }
        },
        {
          "type": "time",
          "name": "time"
        }
      ]
    },
    {
      "id": "cancel_heat_targets",
      "title": {
        "en": "Cancel the temperature targets",
        "fr": "Annuler les objectifs de température"
      }
    },
    {
      "id": "pellets_refilled",
      "title": {
        "en": "Tank refilled (full)",
        "fr": "Réservoir rechargé (plein)"
      },
      "titleFormatted": {
        "en": "Tank refilled (about [[remaining]] % was left)",
        "fr": "Réservoir rechargé (il restait environ [[remaining]] %)"
      },
      "hint": {
        "en": "The tank is considered full (19 kg). The level seen before refilling is optional; when given, it improves the consumption estimate.",
        "fr": "Le réservoir est considéré plein (19 kg). Le niveau vu avant de recharger est facultatif ; s'il est indiqué, il affine l'estimation de consommation."
      },
      "args": [
        {
          "type": "number",
          "name": "remaining",
          "required": false,
          "min": 0,
          "max": 100,
          "step": 5,
          "placeholder": {
            "en": "% left (optional)",
            "fr": "% restant (facultatif)"
          }
        }
      ]
    },
    {
      "id": "set_bag_price",
      "title": {
